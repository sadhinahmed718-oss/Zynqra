<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f0f0f" />
      <stop offset="100%" stop-color="#181818" />
    </linearGradient>
    <linearGradient id="neonGradient512" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f2fe" stop-opacity="1" />
      <stop offset="100%" stop-color="#ff0033" stop-opacity="1" />
    </linearGradient>
    <filter id="neonGlow512" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="15" result="blur1" />
      <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <!-- Background -->
  <rect width="512" height="512" rx="115" fill="url(#bgGrad512)" />
  <rect x="20" y="20" width="472" height="472" rx="95" fill="none" stroke="url(#neonGradient512)" stroke-width="8" opacity="0.9" />
  
  <!-- Logo Inner Elements -->
  <g transform="translate(110, 160) scale(0.6)" filter="url(#neonGlow512)">
    <circle cx="150" cy="150" r="100" stroke="#00f2fe" stroke-width="25" fill="none" stroke-linecap="round"/>
    <path d="M 230 150 Q 256 150, 280 180 L 320 230" stroke="url(#neonGradient512)" stroke-width="20" fill="none" stroke-linecap="round"/>
    <path d="M 320 70 L 450 150 L 320 230 Z" stroke="#ff0033" stroke-width="25" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
