<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="192" height="192">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f0f0f" />
      <stop offset="100%" stop-color="#181818" />
    </linearGradient>
    <linearGradient id="zGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f2fe" />
      <stop offset="100%" stop-color="#ff0033" />
    </linearGradient>
    <filter id="glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="12" result="blur1" />
      <feGaussianBlur stdDeviation="6" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <rect width="512" height="512" rx="115" fill="url(#bgGrad)" />
  <rect x="20" y="20" width="472" height="472" rx="95" fill="none" stroke="url(#zGrad)" stroke-width="6" opacity="0.6" />
  <g filter="url(#glow)">
    <g transform="translate(256, 256)">
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="3s" repeatCount="indefinite" additive="sum" />
      <g transform="translate(-256, -256)">
        <circle cx="190" cy="256" r="75" fill="none" stroke="#00f2fe" stroke-width="18" opacity="0.9"/>
        <circle cx="190" cy="256" r="45" fill="none" stroke="#00f2fe" stroke-width="10" opacity="0.7"/>
        <path d="M 280 195 L 370 256 L 280 317 Z" fill="none" stroke="#ff0033" stroke-width="18" stroke-linejoin="round" opacity="0.9"/>
        <path d="M 295 215 L 345 256 L 295 297 Z" fill="none" stroke="#ff0033" stroke-width="10" stroke-linejoin="round" opacity="0.7"/>
        <path d="M 230 210 Q 256 256 230 302" fill="none" stroke="url(#zGrad)" stroke-width="16" stroke-linecap="round"/>
      </g>
    </g>
  </g>
</svg>
