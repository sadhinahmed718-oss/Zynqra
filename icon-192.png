<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <defs>
    <linearGradient id="bgGrad192" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f0f0f" />
      <stop offset="100%" stop-color="#181818" />
    </linearGradient>
    <linearGradient id="neonGrad192" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f2fe" />
      <stop offset="100%" stop-color="#ff0033" />
    </linearGradient>
    <filter id="glow192" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="6" result="blur1" />
      <feGaussianBlur stdDeviation="3" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background Card -->
  <rect width="192" height="192" rx="42" fill="url(#bgGrad192)" />
  <rect x="8" y="8" width="176" height="176" rx="36" fill="none" stroke="url(#neonGrad192)" stroke-width="3" opacity="0.8" filter="url(#glow192)" />
  
  <!-- Zynqra Neon Icon Graphics -->
  <g transform="translate(38, 44) scale(0.3)" filter="url(#glow192)">
    <circle cx="150" cy="150" r="100" stroke="#00f2fe" stroke-width="25" fill="none" stroke-linecap="round"/>
    <path d="M 230 150 Q 256 150, 280 180 L 320 230" stroke="url(#neonGrad192)" stroke-width="20" fill="none" stroke-linecap="round"/>
    <path d="M 320 70 L 450 150 L 320 230 Z" stroke="#ff0033" stroke-width="25" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
